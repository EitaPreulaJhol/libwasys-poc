//  WasysDriverResource.rc -- embeds the analysed driver image as a binary resource (RCDATA) plus the version block.

#include <windows.h>
#include "WasysDriverResource.h"

IDR_WASYS_DRIVER RCDATA "libwasys.sys"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "EitaPreulaJhol"
            VALUE "FileDescription",  "WasysProcKiller"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "WasysProcKiller"
            VALUE "OriginalFilename", "WasysProcKiller.exe"
            VALUE "ProductName",      "WasysProcKiller"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "LegalCopyright",   "For authorised security testing only"
            VALUE "Comments",         "WasysProcKiller"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
